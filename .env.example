# ConsentHub — environment template for docker compose.
#
# `scripts/boot.sh` copies this file to `.env` on first boot (if `.env` does
# not exist). `.env` is gitignored; only this template is committed.
#
# These are DEV-ONLY placeholders for the local sandbox. Never reuse them in
# a shared or production environment — rotate every value there.

# --- MySQL 8 (docker-compose service: mysql) ---
# Root password used by the image's initialisation and by the healthcheck.
MYSQL_ROOT_PASSWORD=consenthub-root-dev
# Application database created by the image entrypoint.
MYSQL_DATABASE=consenthub
# Application user (ALL PRIVILEGES on MYSQL_DATABASE only) used by the backend.
MYSQL_USER=consenthub
MYSQL_PASSWORD=consenthub-dev

# --- Redis 7 (docker-compose service: redis) ---
# AUTH password (`requirepass`); the backend connects with it.
REDIS_PASSWORD=consenthub-redis-dev
